{
  "extends": ["html-validate:recommended"],
  "rules": {
    "no-redundant-role": "off",
    "void-style": [
      "error",
      {
        "style": "omit"
      }
    ],
    "doctype-style": [
      "error",
      {
        "style": "lowercase"
      }
    ],
    "attribute-boolean-style": [
      "error",
      {
        "style": "empty"
      }
    ],
    "attribute-empty-style": [
      "error",
      {
        "style": "empty"
      }
    ],
    "tel-non-breaking": [
      "error",
      {
        "ignoreClasses": ["button"]
      }
    ]
  }
}
