# Copy to .env to override defaults locally. Nothing here is secret.

# Public address of the deployed site, without a trailing slash.
# Used for canonical links, Open Graph tags and sitemap.xml.
SITE_URL=https://meewe123.github.io/apple-garden

# Path the site is served from. "/apple-garden/" for GitHub Pages
# project sites, "/" for a custom domain or local preview.
PATH_PREFIX=/apple-garden/
